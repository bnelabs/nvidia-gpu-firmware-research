      "bytes": 3697,
      "excerpts": [
        {
          "line_start": 34,
          "line_end": 51,
          "text": "            if pa in mapping:\n                if mapping[pa] != va:\n                    print(f\"[WARNING] Detected multiple VAs for the same PA: {pa} -> {mapping[pa]}, {va}\")\n                    collisions[pa].update([mapping[pa], va])\n                    if keep_duplicates:\n                        mapping[pa] = va\n                # If the same mapping, ignore it\n            else:\n                mapping[pa] = va\n\n    if sort_keys:\n        # sort by numeric value (hex), fallback to string sorting\n        try:\n            mapping = OrderedDict(sorted(mapping.items(), key=lambda kv: int(kv[0], 16)))\n        except Exception:\n            mapping = OrderedDict(sorted(mapping.items(), key=lambda kv: kv[0]))\n\n    return mapping, collisions"
        }
