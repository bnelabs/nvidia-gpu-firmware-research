      "excerpts": [
        {
          "line_start": 95,
          "line_end": 112,
          "text": "def translate_pa(pa: int, pa2va: Dict[str, int],\n                 va_base: int, va_size: int) -> Optional[int]:\n    \"\"\"PA -> VA via the 2MB-base map. Returns None if the bucket isn't\n    mapped or the resulting VA is outside the [va_base, va_base+va_size)\n    window.\"\"\"\n    key = _norm_2mb_key(pa)\n    va_bucket = pa2va.get(key)\n    if va_bucket is None:\n        return None\n    va = va_bucket + (pa & ~MASK_2MB)\n    if va < va_base or va - va_base >= va_size:\n        return None\n    return va\n\n\ndef _emit_one(in_pa_bank: Path, pa2va: Dict[str, int], out_path: Path,\n              va_base: int, va_size: int) -> str:\n    \"\"\"Translate one PA-bank file to its VA-layout output. Returns a one-line summary.\"\"\""
        }
      ]
    },
    {
